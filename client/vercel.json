{
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://hash-food-website.onrender.com/api/:path*"
    },
    {
      "source": "/menu",
      "destination": "/index.html"
    },
    {
      "source": "/menu/:path*",
      "destination": "/index.html"
    },
    {
      "source": "/product/:path*",
      "destination": "/index.html"
    },
    {
      "source": "/checkout",
      "destination": "/index.html"
    },
    {
      "source": "/track/:path*",
      "destination": "/index.html"
    },
    {
      "source": "/track",
      "destination": "/index.html"
    },
    {
      "source": "/admin/:path*",
      "destination": "/index.html"
    }
  ]
}
